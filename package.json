{
  "name": "sseudam",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @sseudam/web --filter @sseudam/server dev",
    "dev:web": "pnpm --filter @sseudam/web dev",
    "dev:server": "pnpm --filter @sseudam/server dev",
    "build": "pnpm -r build",
    "prepare": "husky",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write ."
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md,yml,yaml}": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0"
  }
}
